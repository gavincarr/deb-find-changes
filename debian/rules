#!/usr/bin/make -f

%:
	dh $@

# The binary is pre-built (statically linked Go) and shipped in bin/ via
# scripts/build_all.sh. dh_install picks it up via debian/install; the
# auto build/test/install steps are no-ops.
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:

# Set the compression explicitly so it doesn't depend on the build host's
# distro default.
override_dh_builddeb:
	dh_builddeb -- -Zzstd
